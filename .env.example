# ---------------------------------------------------------------------------
# CloudGuard environment. Copy to .env and fill in. NEVER commit .env.
# Only SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY are safe for the browser;
# everything else is server-side only (SECURITY.md section 3).
# ---------------------------------------------------------------------------

APP_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Supabase -------------------------------------------------------------
# In local dev these may be blank: auth falls back to the local dev issuer.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-side ONLY. Bypasses RLS. Never ships to the frontend.
SUPABASE_SECRET_KEY=
# HS256 secret used to verify Supabase Auth JWTs (Supabase: Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=local-dev-jwt-secret-change-me
JWT_AUDIENCE=authenticated

# --- Database -------------------------------------------------------------
# app_user is RLS-CONSTRAINED and is what the API uses for request handling.
DATABASE_URL=postgresql+asyncpg://cloudguard_app:cloudguard_app@postgres:5432/cloudguard
# Owner connection, used only for migrations and by the worker. Bypasses RLS.
DATABASE_OWNER_URL=postgresql+asyncpg://cloudguard:cloudguard@postgres:5432/cloudguard

REDIS_URL=redis://redis:6379/0

# --- Azure: CloudGuard's OWN multi-tenant app identity --------------------
# This is NOT a customer credential. Customers never paste a secret.
# See AZURE_INTEGRATION.md section 2.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
# Where Entra sends the admin back after consent.
AZURE_REDIRECT_URI=http://localhost:8000/api/v1/cloud-accounts/azure/consent/callback
# Signs the short-lived state token in the consent round-trip.
AZURE_CONSENT_STATE_SECRET=local-dev-consent-secret-change-me

# --- Observability --------------------------------------------------------
SENTRY_DSN=
