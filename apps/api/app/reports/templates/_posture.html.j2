{#
  The posture block, shared by both reports so the executive summary and the
  technical detail can never disagree about the same organization.
#}
<h2>Security posture</h2>

<div class="score-row">
  <span class="score">{{ report.posture.security_score }}</span>
  <span class="muted">/ 100</span>
  {% if report.posture.score_delta is not none %}
    <span class="muted">
      {{ '+' if report.posture.score_delta > 0 else '' }}{{ report.posture.score_delta }}
      since the previous reading
    </span>
  {% else %}
    {# Not "no change". There is nothing to compare against, and the two mean
       opposite things to somebody deciding whether remediation is working. #}
    <span class="muted">no earlier reading to compare against</span>
  {% endif %}
</div>

<table>
  <thead>
    <tr><th>Severity</th><th class="num">Open findings</th></tr>
  </thead>
  <tbody>
    {% for row in report.posture.by_severity %}
    <tr>
      <td><span class="sev sev-{{ row.severity }}">{{ row.severity | title }}</span></td>
      <td class="num">{{ row.count }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<table>
  <tbody>
    <tr><td>Assets under assessment</td><td class="num">{{ report.posture.asset_count }}</td></tr>
    <tr><td>Open findings</td><td class="num">{{ report.posture.open_finding_count }}</td></tr>
    <tr>
      <td>Verified fixed in the last 30 days</td>
      <td class="num">{{ report.posture.verified_resolved_last_30_days }}</td>
    </tr>
    <tr>
      <td>Share of findings ever raised that are now verified fixed</td>
      <td class="num">{{ (report.posture.remediation_rate * 100) | round(0) | int }}%</td>
    </tr>
  </tbody>
</table>
<p class="small muted">
  "Verified fixed" means a later scan observed the check passing. CloudGuard
  never closes a finding because somebody said it was fixed.
</p>
